# Dependencies — reinstalled fresh inside the container
node_modules

# Next.js build output — rebuilt inside the container
.next

# Environment files — secrets must NOT be baked into the image
.env*
.env.local

# Version control
.git
.gitignore

# IDE / editor
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Design mockups (not needed at runtime)
*.html

# Documentation
README.md

# Testing / linting config (not needed in production image)
eslint.config.mjs
